generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mongodb"
  url      = env("DATABASE_URL")
}

model Product {
  id        String @id @default(auto()) @map("_id") @db.ObjectId
  proCode   String
  proDetail String
  proName   String
  proPrice  Float
  /// Multiple data types found: String: 50%, Int: 50% out of 2 sampled entries
  proQty    Json
  proUnit   String
  @@map("product")
}
